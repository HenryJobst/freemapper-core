# LF everywhere: golden files and embedded symbol sets must be byte-identical on all platforms.
* text=auto eol=lf
*.png binary
*.jpg binary
*.zip binary
*.tif binary
*.pdf binary
# Purple Pen fixtures stay byte-identical to the originals (CRLF, BOM); see their README.
*.ppen -text
# The Purple Pen symbol file stays byte-identical to the original (CRLF, BOM); see its README.
crates/freemapper-course/data/purple-pen-symbols.xml -text

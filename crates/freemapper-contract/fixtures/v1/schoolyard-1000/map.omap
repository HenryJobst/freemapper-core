&lt;b&gt;Note: this is a non-standard addition to the symbol set.&lt;/b&gt;</description><line_symbol color="2" line_width="175" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5000" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5000" break_length="1250" dashes_in_group="1" in_group_break_length="625" mid_symbols_per_spot="1" mid_symbol_distance="0"><end_symbol><symbol type="1" code="" name="End symbol"><point_symbol rotatable="true" inner_radius="1250" inner_color="-1" outer_width="0" outer_color="-1" elements="1"><element><symbol type="4" code=""><area_symbol inner_color="2" min_area="0" patterns="0"/></symbol><object type="1"><coords count="5">625 0;-1875 -750;-1250 0;-1875 750;625 0;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol></end_symbol></line_symbol></symbol>
